{
  "name": "open-llm-translator",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: bilingual (immersive-style) page translation powered by LLMs",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:e2e": "node scripts/build.mjs --e2e",
    "icons": "node scripts/build-icons.mjs",
    "package": "node scripts/package.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.8",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
